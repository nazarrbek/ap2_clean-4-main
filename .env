# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Order Service Cache
CACHE_TTL=5m

# Order Service Rate Limiter (Bonus)
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=1m

# Notification Service - Provider Mode
# SIMULATED: Mock provider with 30% failure rate (for testing retries)
# REAL: Real SMTP provider (requires SMTP credentials)
PROVIDER_MODE=SIMULATED

# SMTP Configuration (only used when PROVIDER_MODE=REAL)
SMTP_HOST=smtp.mailjet.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# Retry & Exponential Backoff Configuration
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY=2s
RETRY_MAX_DELAY=30s

# Idempotency TTL (24 hours)
IDEMPOTENCY_TTL=24h
