# ─── Database credentials ────────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=postgres

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=
# Cache TTL for order entries (seconds): 5 minutes
CACHE_TTL=300

# ─── Rate Limiter (Bonus) ────────────────────────────────────────────────────
# Maximum requests per minute per client IP
RATE_LIMIT=10

# ─── Notification Provider ───────────────────────────────────────────────────
# Options: SIMULATED | REAL
PROVIDER_MODE=SIMULATED

# Simulated provider settings
SIMULATE_FAIL_RATE=0.3
SIMULATE_LATENCY_MS=200

# REAL SMTP settings (only used when PROVIDER_MODE=REAL)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password

# ─── Retry Policy ────────────────────────────────────────────────────────────
MAX_RETRIES=3

# ─── Idempotency ─────────────────────────────────────────────────────────────
# How long to remember processed payments (hours)
IDEMPOTENCY_TTL_HOURS=24
